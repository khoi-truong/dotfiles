# Folder view configuration files
.DS_Store
**/.DS_Store
Desktop.ini

# Thumbnail cache files
._*
Thumbs.db

# Files that might appear on external disks
.Spotlight-V100
.Trashes

# Antidote (cloned plugin cache)
antidote/
zsh/antidote/

# Local zsh generated files (history, zcompdump, z data, plugins.zsh, extra.zsh)
zsh/local/

# AI tooling: never commit credentials or machine-local overrides
ai/**/*.local*
ai/claude/.credentials*
ai/claude/settings.local.json
ai/env.local.zsh

# Generated by brew/update.sh, for manual reconciliation
brew/Brewfile.generated

# Agent/tooling scratch state
.omc/
.herdr/
.ruby-lsp/
__pycache__/
ai/omp/config.yml.lock

# Local files
*.local
