# curl reads this for every invocation (~/.curlrc), so keep it to safe,
# non-behavioural defaults — scripts that shell out to curl inherit it too.

# When following a redirect, carry the previous URL as the referer.
referer = ";auto"

# Give up if the connection can't be established within 60s (connection
# phase only, not the whole transfer).
connect-timeout = 60

# Retry a few times on transient failures (5xx, 429, and — via
# retry-connrefused — a refused connection), backing off 2s between tries.
retry = 3
retry-delay = 2
retry-connrefused
