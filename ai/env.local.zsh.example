# Sourced by ai/aliases.zsh, which zshrc sources. Gitignored — copy to
# ai/env.local.zsh and fill in. `chmod 600` it: these are plaintext secrets.
#
# export ANTHROPIC_API_KEY="sk-ant-..."
#
# DEEPSEEK_API_KEY backs the `ccd` provider (ai/claude/providers.zsh). It lives
# here rather than behind `op read` because the key is resolved on every launch
# and a biometric prompt cannot be answered by an agent pane that
# ai/herdr/team.sh spawned — it reads as a hung spawn and stops the workflow.
# Keep the master copy in 1Password; this is the launch-time copy.
#
#   op read op://<vault>/<item>/PI_CODING_AGENT
#
# export DEEPSEEK_API_KEY="sk-..."
