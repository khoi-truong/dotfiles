{
  "compilerOptions": {
    "target": "es2024",
    "lib": [
      "es2024"
    ],
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "paths": {
      "*": [
        "./node_modules/*",
        "./node_modules/@earendil-works/pi-coding-agent/node_modules/*"
      ]
    }
  },
  "include": [
    "extensions/**/*.ts"
  ]
}
