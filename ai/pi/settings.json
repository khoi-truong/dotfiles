{
  "defaultProvider": "deepseek",
  "defaultModel": "deepseek-flash",
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": true,
  "enabledModels": [
    "deepseek-flash"
  ],
  "theme": "gruvbox-dark",
  "quietStartup": true,
  "collapseChangelog": true,
  "enableInstallTelemetry": false,
  "showCacheMissNotices": true,
  "markdown": {
    "mermaid": "final"
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 32768,
    "keepRecentTokens": 60000
  },
  "httpIdleTimeoutMs": 600000,
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "provider": {
      "timeoutMs": 600000,
      "maxRetries": 0
    }
  },
  "skills": [
    "~/.dotfiles/ai/claude/skills"
  ],
  "packages": [
    "npm:pi-web-access@0.29.0",
    "npm:pi-mcp-adapter@2.34.0",
    {
      "source": "npm:pi-subagents@0.68.0",
      "skills": [],
      "prompts": []
    }
  ],
  "npmCommand": [
    "npm",
    "--ignore-scripts"
  ],
  "subagents": {
    "agentOverrides": {
      "claude-code": { "disabled": true },
      "claude-code-writer": { "disabled": true },
      "codex-exec": { "disabled": true },
      "codex-exec-writer": { "disabled": true },
      "cursor-agent": { "disabled": true },
      "cursor-agent-writer": { "disabled": true }
    }
  },
  "lastChangelogVersion": "0.85.1"
}