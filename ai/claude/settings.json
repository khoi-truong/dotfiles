  "extraKnownMarketplaces": {
    "omc": {
      "source": {
        "source": "git",
        "url": "https://github.com/Yeachan-Heo/oh-my-claudecode.git"
      }
    },
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    }
  },
  "autoCompactWindow": 190000,
  "tui": "fullscreen",
  "autoMemoryEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "teammateMode": "in-process",
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(brew bundle cleanup:*) in ~/.dotfiles — uninstalls everything absent from the Brewfile per repo AGENTS.md",
      "Bash(git push --force*) and Bash(git reset --hard*) in ~/.dotfiles — repo AGENTS.md blocks these; hand to user"
    ],
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
