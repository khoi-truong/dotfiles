# brew/Brewfile — the single source of truth for everything installed via
# Homebrew on this machine.
#
#   sh brew/setup.sh              install
#   sh brew/setup.sh --cleanup    install + uninstall anything not listed here
#   sh brew/update.sh             dump what's installed, to reconcile
#
# Runtimes (python, node, ruby, go, java, rust) are NOT here — they are managed
# by mise; see mise/global.toml.

# ------------------------------------------------------------- formulae -----

