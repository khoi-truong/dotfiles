# ~/.zshrc (symlink to $DOTFILES/zsh/zshrc) — interactive shell setup.
#
# Load order matters:
#   env.zsh     PATH + toolchain env (must be first; plugins probe $PATH)
#   config.zsh  options, history, editor
#   omz.zsh     oh-my-zsh settings (must precede the plugin bundle)
#   compinit    omz $ZSH setup + cached compinit (oh-my-zsh.sh is bypassed)
#   plugins     antidote static bundle (omz lib + theme, plugins)
#   aliases     ours load *after* plugins so they win
#   tools       mise / fzf / zoxide
#   extra.zsh   machine-local, gitignored
#
# Profiling: `ZSH_PROFILE=1 zsh -i -c exit` prints a zprof report. See README.

[[ -n ${ZSH_PROFILE:-} ]] && zmodload zsh/zprof

export DOTFILES="${DOTFILES:-${HOME}/.dotfiles}"
ZSH_DIR="${DOTFILES}/zsh"
ZSH_LOCAL="${ZSH_DIR}/local"
[[ -d $ZSH_LOCAL ]] || mkdir -p "$ZSH_LOCAL"

export ANTIDOTE_HOME="${ZSH_DIR}/antidote"
export ZSH_COMPDUMP="${ZSH_LOCAL}/zcompdump-${SHORT_HOST:-${HOST}}-${ZSH_VERSION}"
export HISTFILE="${ZSH_LOCAL}/history"
export LESSHISTFILE="${ZSH_LOCAL}/lesshst"

source "${ZSH_DIR}/env.zsh"
source "${ZSH_DIR}/config.zsh"
source "${ZSH_DIR}/omz.zsh"

# --- plugins ---------------------------------------------------------------
# Clone antidote if missing and regenerate the static bundle whenever
# zsh.plugins changes. Sourcing the generated file is the fast path: antidote
# itself is not loaded on a normal start.
zstyle ':antidote:bundle' use-friendly-names 'yes'
if [[ ! ${ZSH_LOCAL}/plugins.zsh -nt ${ZSH_DIR}/zsh.plugins ]]; then
  [[ -e $ANTIDOTE_HOME ]] \
    || git clone --depth=1 https://github.com/mattmc3/antidote.git "$ANTIDOTE_HOME"
  [[ -e ${ZSH_DIR}/zsh.plugins ]] || touch "${ZSH_DIR}/zsh.plugins"
  (
    source "${ANTIDOTE_HOME}/antidote.zsh"
    antidote bundle <"${ZSH_DIR}/zsh.plugins" >"${ZSH_LOCAL}/plugins.zsh"
  )
fi
# Makes `antidote update` available on demand without loading the plugin.
autoload -Uz "${ANTIDOTE_HOME}/functions/antidote"

# --- oh-my-zsh setup + compinit ------------------------------------------
# What oh-my-zsh.sh did, minus its per-start forks (scutil, git rev-parse, grep,
# tee, mkdir/rm lock, zrecompile). compinit must run before the bundle: omz lib
# and plugins call `compdef` at source time.
export ZSH="${ANTIDOTE_HOME:A}/robbyrussell/oh-my-zsh"
ZSH_CUSTOM="${ZSH}/custom"
ZSH_CACHE_DIR="${ZSH}/cache"
[[ -w $ZSH_CACHE_DIR ]] || ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/oh-my-zsh"
[[ -d ${ZSH_CACHE_DIR}/completions ]] || mkdir -p "${ZSH_CACHE_DIR}/completions"
SHORT_HOST="${HOST/.*/}"
fpath=("${ZSH}"/{functions,completions} "${ZSH_CUSTOM}"/{functions,completions} "${ZSH_CACHE_DIR}/completions" $fpath)
autoload -Uz compaudit compinit zrecompile

# Trust the dump (-C) while it is under a day old and newer than the plugin
# bundle and env.zsh (which sets fpath). Otherwise truncate it so compinit is
# forced to rescan $fpath and rewrite it; plain compinit keeps a dump whose
# directory count happens to match.
_zcd_fresh=( ${ZSH_COMPDUMP}(N.mh-24) )
if (( $#_zcd_fresh )) \
  && [[ ! ${ZSH_LOCAL}/plugins.zsh -nt $ZSH_COMPDUMP && ! ${ZSH_DIR}/env.zsh -nt $ZSH_COMPDUMP ]]; then
  compinit -C -d "$ZSH_COMPDUMP"
else
  : >| "$ZSH_COMPDUMP"
  compinit -u -d "$ZSH_COMPDUMP"
fi
unset _zcd_fresh
[[ ${ZSH_COMPDUMP}.zwc -nt $ZSH_COMPDUMP ]] || zcompile "$ZSH_COMPDUMP"

source "${ZSH_LOCAL}/plugins.zsh"
# oh-my-zsh.sh's last step: completion colours match `ls`, after the theme.
[[ -z $LS_COLORS ]] || zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# --- aliases & functions ---------------------------------------------------
source "${ZSH_DIR}/aliases.zsh"
[[ $OSTYPE == darwin* ]] && source "${ZSH_DIR}/aliases.macos.zsh"
source "${ZSH_DIR}/functions.zsh"
[[ -r ${DOTFILES}/ai/aliases.zsh ]] && source "${DOTFILES}/ai/aliases.zsh"

# --- tools -----------------------------------------------------------------
# mise: the only version manager (python, node, ruby, go, java, ...).
# Do not add any other *env init hooks here; see mise/global.toml.
(( $+commands[mise] )) && eval "$(mise activate zsh)"

# fzf key bindings + completion (fzf >= 0.48 ships `fzf --zsh`).
# The tty guard keeps `zsh -i -c ...` quiet: fzf's key-bindings script
# save/restores every shell option, and restoring `zle` fails without a tty.
(( $+commands[fzf] )) && [[ -t 0 ]] && source <(fzf --zsh)

# zoxide: directory jumper (`z`, `zi`).
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"

# --- fast-syntax-highlighting theme ---------------------------------------
# fast-theme is slow, so only run it when the desired theme differs from the
# one recorded in the local marker file.
FSH_THEME="default"
FSH_CURRENT_THEME=""
if [[ -f "${ZSH_LOCAL}/theme.fsh" ]]; then
  read -r FSH_CURRENT_THEME < "${ZSH_LOCAL}/theme.fsh"
fi
if [[ $FSH_CURRENT_THEME != "$FSH_THEME" ]]; then
  fast-theme "$FSH_THEME"
  echo "$FSH_THEME" > "${ZSH_LOCAL}/theme.fsh"
  FSH_OVERLAY="${ZSH_DIR}/plugin-configs/fast-syntax-highlighting/${FSH_THEME}-overlay.ini"
  [[ -e $FSH_OVERLAY ]] && fast-theme "$FSH_OVERLAY"
  unset FSH_OVERLAY
fi
unset FSH_THEME FSH_CURRENT_THEME

# --- machine-local overrides ----------------------------------------------
# zsh/local/ is gitignored. Installers that want to append to PATH (Windsurf,
# Antigravity, vendor SDKs) should write here, never into this file.
[[ -r ${ZSH_LOCAL}/extra.zsh ]] && source "${ZSH_LOCAL}/extra.zsh"

unset ZSH_DIR ZSH_LOCAL

[[ -n ${ZSH_PROFILE:-} ]] && zprof
