#!/usr/bin/env zsh
# shellcheck disable=SC1071  # shellcheck has no zsh mode; zsh -n is the check
# ~/.zshrc (symlink to $DOTFILES/zsh/zshrc) — interactive shell setup.
#
# Load order matters:
#   env.zsh     PATH + toolchain env (must be first; plugins probe $PATH)
#   config.zsh  options, history, editor
#   omz.zsh     oh-my-zsh settings (must precede the plugin bundle)
#   compinit    omz $ZSH setup + cached compinit (oh-my-zsh.sh is bypassed)
#   plugins     antidote static bundle (omz lib + theme, plugins)
#   aliases     ours load *after* plugins so they win
#   tools       mise / fzf / zoxide
#   extra.zsh   machine-local, gitignored
#
# Profiling: `ZSH_PROFILE=1 zsh -i -c exit` prints a zprof report. See README.

[[ -n ${ZSH_PROFILE:-} ]] && zmodload zsh/zprof

export DOTFILES="${DOTFILES:-${HOME}/.dotfiles}"
ZSH_DIR="${DOTFILES}/zsh"
ZSH_LOCAL="${ZSH_DIR}/local"
[[ -d $ZSH_LOCAL ]] || mkdir -p "$ZSH_LOCAL"

export ANTIDOTE_HOME="${ZSH_DIR}/antidote"
export ZSH_COMPDUMP="${ZSH_LOCAL}/zcompdump-${SHORT_HOST:-${HOST}}-${ZSH_VERSION}"
# Not exported: a bash started from zsh would inherit it and write into it.
HISTFILE="${ZSH_LOCAL}/history"
export LESSHISTFILE="${ZSH_LOCAL}/lesshst"
export PYTHON_HISTORY="${ZSH_LOCAL}/python_history" # Python 3.13+
export NODE_REPL_HISTORY="${ZSH_LOCAL}/node_repl_history"

source "${ZSH_DIR}/env.zsh"
source "${ZSH_DIR}/config.zsh"
source "${ZSH_DIR}/omz.zsh"

# --- plugins ---------------------------------------------------------------
# Clone antidote if missing and regenerate the static bundle whenever
# zsh.plugins changes. Sourcing the generated file is the fast path: antidote
# itself is not loaded on a normal start.
zstyle ':antidote:bundle' use-friendly-names 'yes'
if [[ ! ${ZSH_LOCAL}/plugins.zsh -nt ${ZSH_DIR}/zsh.plugins ]]; then
  [[ -e $ANTIDOTE_HOME ]] \
    || git clone --depth=1 https://github.com/mattmc3/antidote.git "$ANTIDOTE_HOME"
  [[ -e ${ZSH_DIR}/zsh.plugins ]] || touch "${ZSH_DIR}/zsh.plugins"
  (
    source "${ANTIDOTE_HOME}/antidote.zsh"
    antidote bundle <"${ZSH_DIR}/zsh.plugins" >"${ZSH_LOCAL}/plugins.zsh"
  )
fi
# Makes `antidote update` available on demand without loading the plugin.
autoload -Uz "${ANTIDOTE_HOME}/functions/antidote"

# --- oh-my-zsh setup + compinit ------------------------------------------
# What oh-my-zsh.sh did, minus its per-start forks (scutil, git rev-parse, grep,
# tee, mkdir/rm lock, zrecompile). compinit must run before the bundle: omz lib
# and plugins call `compdef` at source time.
export ZSH="${ANTIDOTE_HOME:A}/robbyrussell/oh-my-zsh"
ZSH_CUSTOM="${ZSH}/custom"
ZSH_CACHE_DIR="${ZSH}/cache"
[[ -w $ZSH_CACHE_DIR ]] || ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/oh-my-zsh"
[[ -d ${ZSH_CACHE_DIR}/completions ]] || mkdir -p "${ZSH_CACHE_DIR}/completions"
SHORT_HOST="${HOST/.*/}"
fpath=("${ZSH}"/{functions,completions} "${ZSH_CUSTOM}"/{functions,completions} "${ZSH_CACHE_DIR}/completions" $fpath)
autoload -Uz compaudit compinit zrecompile

# Trust the dump (-C) while it is under a day old and newer than the plugin
# bundle and env.zsh (which sets fpath). Otherwise truncate it so compinit is
# forced to rescan $fpath and rewrite it; plain compinit keeps a dump whose
# directory count happens to match.
_zcd_fresh=( ${ZSH_COMPDUMP}(N.mh-24) )
if (( $#_zcd_fresh )) \
  && [[ ! ${ZSH_LOCAL}/plugins.zsh -nt $ZSH_COMPDUMP && ! ${ZSH_DIR}/env.zsh -nt $ZSH_COMPDUMP ]]; then
  compinit -C -d "$ZSH_COMPDUMP"
else
  : >| "$ZSH_COMPDUMP"
  compinit -u -d "$ZSH_COMPDUMP"
fi
unset _zcd_fresh
[[ ${ZSH_COMPDUMP}.zwc -nt $ZSH_COMPDUMP ]] || zcompile "$ZSH_COMPDUMP"

# zcompile the bundle and every plugin file it sources, once per regeneration.
# .zwc files land next to the sources in the gitignored antidote cache; zsh only
# uses foo.zwc when it is newer than foo, so `antidote update` never loads stale
# wordcode. plugins.zsh.zwc is the stamp, written last. -U: don't bake aliases.
if [[ ! ${ZSH_LOCAL}/plugins.zsh.zwc -nt ${ZSH_LOCAL}/plugins.zsh ]]; then
  _zc_src=( ${${(M)${(f)"$(<${ZSH_LOCAL}/plugins.zsh)"}:#source *}#source } )
  for _zc_f in $_zc_src; do
    [[ ${_zc_f:t} == fast-syntax-highlighting.plugin.zsh ]] \
      && _zc_src+=( "${_zc_f:h}/fast-highlight" "${_zc_f:h}/fast-string-highlight" )
  done
  for _zc_f in $_zc_src; do
    [[ -r $_zc_f && -w ${_zc_f:h} && ! ${_zc_f}.zwc -nt $_zc_f ]] \
      && zcompile -U -- "$_zc_f" 2>/dev/null
  done
  [[ -w $ZSH_LOCAL ]] && zcompile -U -- "${ZSH_LOCAL}/plugins.zsh" 2>/dev/null
  unset _zc_src _zc_f
fi

# omz git.plugin execs `git version` only to gate aliases. Serve it from a cache
# keyed on the resolved binary (stale once that binary is newer) via a function
# shim that lives only while the bundle is sourced. /usr/bin/git is xcrun's
# trampoline, whose output depends on xcode-select, so it stays live.
_gv_cache="${ZSH_LOCAL}/git-version"
_gv_bin=${commands[git]:A}
_gv_shim=0
if (( $+commands[git] )) && ! (( $+functions[git] )) && [[ $_gv_bin != /usr/bin/git ]]; then
  _gv=()
  [[ -r $_gv_cache && $_gv_cache -nt $_gv_bin ]] && _gv=( "${(@f)$(<$_gv_cache)}" )
  if [[ $_gv[1] != "$_gv_bin" || -z $_gv[2] ]]; then
    _gv=( "$_gv_bin" "$(command git version 2>/dev/null)" )
    [[ -n $_gv[2] ]] && { print -rl -- $_gv >| $_gv_cache } 2>/dev/null
  fi
  if [[ -n $_gv[2] ]]; then
    git() {
      if [[ $# -eq 1 && $1 == version ]]; then print -r -- "$_gv[2]"; else command git "$@"; fi
    }
    _gv_shim=1
  fi
fi

source "${ZSH_LOCAL}/plugins.zsh"
(( _gv_shim )) && unfunction git
unset _gv _gv_cache _gv_bin _gv_shim
# oh-my-zsh.sh's last step: completion colours match `ls`, after the theme.
[[ -z $LS_COLORS ]] || zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# --- aliases & functions ---------------------------------------------------
source "${ZSH_DIR}/aliases.zsh"
[[ $OSTYPE == darwin* ]] && source "${ZSH_DIR}/aliases.macos.zsh"
source "${ZSH_DIR}/functions.zsh"
[[ -r ${DOTFILES}/ai/aliases.zsh ]] && source "${DOTFILES}/ai/aliases.zsh"

# --- tools -----------------------------------------------------------------
# Tool init output is cached in zsh/local/init-<tool>-<binary path>.zsh,
# rebuilt when the binary or this file is newer; the warm path forks nothing.
# Delete zsh/local/init-*.zsh to force a rebuild. Sets REPLY to the cache file;
# returns 1 (caller falls back to the live init) if it cannot be produced.
# With `-k KEY DEP... --` the output also depends on KEY and the files DEP:
# KEY is stored as the first line and must match exactly, any DEP newer than
# the cache rebuilds it, and REPLY is the cached script itself (eval it), read
# once so the bytes checked are the bytes run.
_zshrc_init_cache() {
  local hdr buf out f
  local -a deps
  if [[ $1 == -k ]]; then
    hdr="# key ${(qqqq)2}"
    shift 2
    while (( $# )) && [[ $1 != -- ]]; do deps+=( "$1" ); shift; done
    shift
  fi
  local bin=${commands[$1]:A}
  local cache=${ZSH_LOCAL}/init-$1-${bin//[^A-Za-z0-9._-]/_}.zsh
  if [[ -n $hdr && -s $cache && -r $cache && ! $bin -nt $cache && ! ${ZSH_DIR}/zshrc -nt $cache ]]; then
    for f in $deps; do [[ $f -nt $cache ]] && break; done
    [[ $f -nt $cache ]] || buf=$(<$cache)
    [[ ${buf[1,${#hdr}+1]} == "$hdr"$'\n' ]] || buf=
  fi
  if [[ ! -s $cache || $bin -nt $cache || ${ZSH_DIR}/zshrc -nt $cache || -n $hdr && -z $buf ]]; then
    zmodload -F zsh/files b:zf_mv b:zf_rm || return 1
    # The empty temp file stamps the start: a DEP edited while the tool runs
    # is newer than it, and that output is not cached.
    { : >| $cache.tmp.$$ } 2>/dev/null || return 1
    out=$("${commands[$1]}" "${@:2}" 2>/dev/null) && [[ -n $out ]] \
      || { zf_rm -f -- $cache.tmp.$$ 2>/dev/null; return 1 }
    for f in $deps; do
      [[ $f -nt $cache.tmp.$$ ]] && { zf_rm -f -- $cache.tmp.$$ 2>/dev/null; return 1 }
    done
    buf=${hdr:+$hdr$'\n'}$out
    { print -r -- $buf >| $cache.tmp.$$ } 2>/dev/null \
      && zf_mv -f -- $cache.tmp.$$ $cache 2>/dev/null \
      || { zf_rm -f -- $cache.tmp.$$ 2>/dev/null; return 1 }
    for f in ${ZSH_LOCAL}/init-$1-*.zsh(N); do
      [[ $f == "$cache" ]] || zf_rm -f -- $f 2>/dev/null
    done
  fi
  REPLY=${${hdr:+${buf[${#hdr}+2,-1]}}:-$cache}
}

# mise: the only version manager (python, node, ruby, go, java, ...).
# Do not add any other *env init hooks here; see mise/global.toml.
# `mise activate zsh` bakes in PATH, the binary path, every MISE_* setting and
# the settings of each config that applies here, so all of those form the key
# and the candidate config files (plus trust state) are its DEPs. The session
# and hook-flag variables do not change the output. Env vars that rename
# config files, and any miserc (it can move the config dirs), bypass the cache.
# Nested shells in a project usually miss.
if (( $+commands[mise] )); then
  if [[ -z ${MISE_DEFAULT_CONFIG_FILENAME+x}${MISE_OVERRIDE_CONFIG_FILENAMES+x}${MISE_DEFAULT_TOOL_VERSIONS_FILENAME+x}${MISE_OVERRIDE_TOOL_VERSIONS_FILENAMES+x} ]]; then
    _zm_cfg=${MISE_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/mise}
    _zm_sys=${MISE_SYSTEM_CONFIG_DIR:-${MISE_SYSTEM_DIR:-/etc/mise}}
    _zm_state=${MISE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/mise}
    _zm_deps=(
      $_zm_cfg/((config|mise)(|.*)|settings|miserc).toml(N) $_zm_cfg/conf.d/*.toml(N)
      $_zm_sys/(config|mise)(|.*).toml(N) $_zm_sys/conf.d/*.toml(N) $_zm_sys/miserc.toml(N)
      $_zm_state/(trusted|ignored)-configs(N)
    )
    for _zm_f in ${MISE_GLOBAL_CONFIG_FILE-} ${MISE_SYSTEM_CONFIG_FILE:-/etc/mise/config.toml}; do
      [[ -e $_zm_f ]] && _zm_deps+=( $_zm_f )
    done
    _zm_dirs=()
    for _zm_d in $PWD ${${PWD:A}:#${(b)PWD}}; do
      while _zm_dirs+=( "${_zm_d%/}" ) && [[ $_zm_d != / ]]; do _zm_d=${_zm_d:h}; done
    done
    # One directory read per ancestor; descend only into what exists.
    for _zm_d in "${(@u)_zm_dirs}"; do
      for _zm_f in $_zm_d/(.config|.miserc.toml|.tool-versions|(|.)mise(|(|.*).toml))(N); do
        case ${_zm_f:t} in
          (.config) _zm_deps+=( $_zm_f/(miserc|mise(|.*)).toml(N) )
            [[ $_zm_f/mise == $_zm_cfg ]] ||
              _zm_deps+=( $_zm_f/mise/(config|mise)(|.*).toml(N) $_zm_f/mise/conf.d/*.toml(N) ) ;;
          (mise|.mise) _zm_deps+=( $_zm_f/config(|.*).toml(N) $_zm_f/conf.d/*.toml(N) ) ;;
          (*) _zm_deps+=( $_zm_f ) ;;
        esac
      done
    done
    _zm_deps=( ${(u)_zm_deps} )
    if [[ -z ${(M)_zm_deps:#*/(|.)miserc.toml} ]]; then
      _zm_key=( ${commands[mise]:A} "PATH=$PATH" "HOME=$HOME" "XDG_CONFIG_HOME=${XDG_CONFIG_HOME-}"
        "XDG_DATA_HOME=${XDG_DATA_HOME-}" "XDG_STATE_HOME=${XDG_STATE_HOME-}" )
      for _zm_f in ${(ok)parameters[(I)(MISE_*|__MISE_*)]}; do
        [[ $_zm_f == __MISE_(SESSION|ZSH_PRECMD_RUN|ZSH_CHPWD_RAN) ]] || _zm_key+=( "$_zm_f=${(P)_zm_f}" )
      done
      for _zm_f in $_zm_deps; do _zm_key+=( "$_zm_f" "${_zm_f:A}" ); done
    fi
  fi
  if (( $+_zm_key )) && _zshrc_init_cache -k "${(pj:\0:)_zm_key}" $_zm_deps -- mise activate zsh; then
    eval "$REPLY"
  else
    eval "$(mise activate zsh)"
  fi
  unset _zm_cfg _zm_sys _zm_state _zm_deps _zm_dirs _zm_d _zm_f _zm_key
fi

# fzf key bindings + completion (fzf >= 0.48 ships `fzf --zsh`).
# The tty guard keeps `zsh -i -c ...` quiet: fzf's key-bindings script
# save/restores every shell option, and restoring `zle` fails without a tty.
if (( $+commands[fzf] )) && [[ -t 0 ]]; then
  if _zshrc_init_cache fzf --zsh; then
    source "$REPLY"
  else
    source <(fzf --zsh)
  fi
fi

# zoxide: directory jumper (`z`, `zi`). _ZO_ECHO/_ZO_RESOLVE_SYMLINKS are baked
# into its init output, so skip the cache when either is set.
if (( $+commands[zoxide] )); then
  if [[ -z ${_ZO_ECHO+x}${_ZO_RESOLVE_SYMLINKS+x} ]] && _zshrc_init_cache zoxide init zsh; then
    source "$REPLY"
  else
    eval "$(zoxide init zsh)"
  fi
fi
unfunction _zshrc_init_cache

# --- fast-syntax-highlighting theme ---------------------------------------
# fast-theme is slow, so only run it when the desired theme differs from the
# one recorded in the local marker file.
FSH_THEME="default"
FSH_CURRENT_THEME=""
if [[ -f "${ZSH_LOCAL}/theme.fsh" ]]; then
  read -r FSH_CURRENT_THEME < "${ZSH_LOCAL}/theme.fsh"
fi
if [[ $FSH_CURRENT_THEME != "$FSH_THEME" ]]; then
  fast-theme "$FSH_THEME"
  echo "$FSH_THEME" > "${ZSH_LOCAL}/theme.fsh"
  FSH_OVERLAY="${ZSH_DIR}/plugin-configs/fast-syntax-highlighting/${FSH_THEME}-overlay.ini"
  [[ -e $FSH_OVERLAY ]] && fast-theme "$FSH_OVERLAY"
  unset FSH_OVERLAY
fi
unset FSH_THEME FSH_CURRENT_THEME

# --- machine-local overrides ----------------------------------------------
# zsh/local/ is gitignored. Installers that want to append to PATH (Windsurf,
# Antigravity, vendor SDKs) should write here, never into this file.
[[ -r ${ZSH_LOCAL}/extra.zsh ]] && source "${ZSH_LOCAL}/extra.zsh"

unset ZSH_DIR ZSH_LOCAL

[[ -n ${ZSH_PROFILE:-} ]] && zprof
