# ~/.gitconfig — linked from ~/.dotfiles/git/gitconfig by git/setup.sh.
#
# Sections are alphabetical. Machine-specific settings (user.*, gpg.program)
# live in ~/.config/git/gitconfig.local, included last so it can override
# anything here. Global ignores go in ~/.config/git/ignore (git's default).

# ─── Core ────────────────────────────────────────────────────────────────────

[core]
  # macOS: HFS+/APFS store names decomposed; report them precomposed so
  # non-ASCII filenames aren't shown as untracked.
  precomposeUnicode = true
  # macOS: ctime changes spuriously (Spotlight, backups); ignore it.
  trustctime = false
  # Cache untracked-file lookups to speed up `git status`.
  untrackedCache = true
  # delta (brew/Brewfile). Only used when stdout is a TTY, so a captured
  # `git diff` — an agent reading a diff, a script — is still plain text.
  pager = delta

[init]
  defaultBranch = main
  # New repos get hooks/pre-commit (gitleaks secret scan) and
  # hooks/post-checkout (seeds new worktrees from .worktreeclone).
  templateDir = ~/.config/git/template/

[worktree]
  # Absolute gitdir pointers. Relative ones survive moving the repo, but
  # zsh/zshenv hardcodes ~/.dotfiles anyway, and GitKraken's libgit2 layer
  # resolves a relative `gitdir: ../...` against the wrong base and refuses the
  # worktree. This only affects worktrees created from here on: `git worktree
  # repair` fixes broken pointers but leaves a valid relative one alone, so an
  # existing worktree keeps its format until it is removed and re-added.
  useRelativePaths = false

[help]
  # Ask before running a mistyped command's best guess.
  autocorrect = prompt

[column]
  ui = auto

# ─── Committing ──────────────────────────────────────────────────────────────

[commit]
  gpgSign = true
  # Commented Conventional-Commits skeleton; `git commit -m` bypasses it.
  template = ~/.dotfiles/git/gitmessage.txt
  # Show the diff being committed in the editor.
  verbose = true

[tag]
  sort = version:refname

[rerere]
  # Remember conflict resolutions and replay them.
  enabled = true
  autoUpdate = true

# ─── Branches, fetching, pushing ─────────────────────────────────────────────

[branch]
  sort = -committerdate

[fetch]
  # Drop remote-tracking branches deleted upstream.
  prune = true

[pull]
  ff = only

[push]
  default = current
  autoSetupRemote = true
  # Push annotated tags reachable from the pushed commits.
  followTags = true

[rebase]
  # Honour fixup!/squash! commits, stash around the rebase, and move
  # stacked branches along with it.
  autoSquash = true
  autoStash = true
  updateRefs = true

[merge]
  # Show the common ancestor in conflict hunks, minus the shared lines.
  conflictStyle = zdiff3
  # Summarise merged commits in the merge message.
  log = true

[transfer]
  # Verify every object received or sent.
  fsckObjects = true

# ─── Diffs and patches ───────────────────────────────────────────────────────

[diff]
  algorithm = histogram
  # Colour moved blocks differently from real additions/deletions.
  colorMoved = plain
  # Prefix paths with i/ w/ c/ (index, worktree, commit) instead of a/ b/.
  mnemonicPrefix = true
  # Detect copies as well as renames.
  renames = copies

[delta]
  # n / N jump between files in the diff.
  navigate = true
  line-numbers = true
  side-by-side = true
  # delta borrows bat's themes; matches the iTerm2 Gruvbox preset.
  # Names: `delta --list-syntax-themes`.
  syntax-theme = gruvbox-dark

# The options above suit a full-width terminal pager; lazygit's diff panel is
# narrow and drives its own scrolling, so git/lazygit.yml calls delta with
# --features=lazygit to override them. navigate needs a real pager to work.
[delta "lazygit"]
  navigate = false
  side-by-side = false
  line-numbers = true
  # Clickable line numbers that open the file in $EDITOR at that line.
  hyperlinks = true
  hyperlinks-file-link-format = lazygit-edit://{path}:{line}

[interactive]
  # Colour `git add -p` hunks through delta too.
  diffFilter = delta --color-only

[apply]
  # Fix whitespace errors when applying a patch.
  whitespace = fix

[status]
  submoduleSummary = true

# ─── Colours ─────────────────────────────────────────────────────────────────

[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green

[color "diff"]
  meta = yellow bold
  frag = magenta bold
  old = red
  new = green

[color "status"]
  added = yellow
  changed = green
  untracked = cyan

# ─── URL shorthands ──────────────────────────────────────────────────────────
# `git clone gh:user/repo` (SSH) or `github:user/repo` (HTTPS, pushes via SSH).

[url "git@github.com:"]
  insteadOf = gh:
  pushInsteadOf = github:
  pushInsteadOf = https://github.com/

[url "https://github.com/"]
  insteadOf = github:

[url "git@gist.github.com:"]
  insteadOf = gst:
  pushInsteadOf = gist:
  pushInsteadOf = https://gist.github.com/

[url "https://gist.github.com/"]
  insteadOf = gist:

# ─── Aliases ─────────────────────────────────────────────────────────────────

[alias]
  # Status and history
  s = status --short --branch
  l = log --graph --oneline --decorate -n 20
  whoami = config user.email
  aliases = config --get-regexp ^alias\\.

  # Committing
  amend = commit --amend --reuse-message=HEAD
  amendp = !git add --all && git commit --amend --reuse-message=HEAD && git push --force-with-lease
  # Undo the last commit, keeping its changes staged.
  undo = reset --soft HEAD~1
  # Fold staged changes into <commit>: `git fixup <sha>`.
  fixup = "!f() { sha=$(git rev-parse \"$1\") && git commit --fixup=\"$sha\" && GIT_SEQUENCE_EDITOR=: git rebase --interactive --autosquash \"$sha~1\"; }; f"
  # Interactive rebase of the last N commits.
  reb = "!f() { git rebase --interactive HEAD~\"$1\"; }; f"

  # Delete local branches merged into the default branch or gone upstream.
  tidy = "!f() { git fetch --prune; base=$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null || echo main); git branch --merged \"$base\" --format='%(refname:short)' | grep -vxE \"main|master|${base#origin/}|$(git branch --show-current)\" | xargs -n 1 git branch -d; git branch --format='%(refname:short) %(upstream:track)' | awk '$2 == \"[gone]\" { print $1 }' | xargs -n 1 git branch -D; git worktree prune; }; f"

  # Worktrees: `git wt` lists them; `git wta <branch>` adds ../<repo>-<branch>
  # on that branch, creating it if needed.
  wt = worktree list
  wta = "!f() { b=\"$1\"; d=\"../$(basename \"$PWD\")-$(printf %s \"$b\" | tr / -)\"; if git show-ref --verify --quiet \"refs/heads/$b\"; then git worktree add \"$d\" \"$b\"; else git worktree add -b \"$b\" \"$d\"; fi; }; f"

  # Structural diff (difftastic): compares syntax trees, so a pure reindent or
  # a moved function reads as no change. Slower than delta; on demand only, and
  # scoped to this alias so nothing else sees diff.external.
  dft = -c diff.external=difft diff

  # Searching: branches containing a commit; commits by code or message.
  fb = "!f() { git branch --all --contains \"$1\"; }; f"
  fc = "!f() { git log --pretty=format:'%C(yellow)%h  %Cblue%ad  %Creset%s%Cgreen  [%cn] %Cred%d' --decorate --date=short -S\"$1\"; }; f"
  fm = "!f() { git log --pretty=format:'%C(yellow)%h  %Cblue%ad  %Creset%s%Cgreen  [%cn] %Cred%d' --decorate --date=short --grep=\"$1\"; }; f"

# ─── Machine-local overrides (must stay last) ───────────────────────────────

[include]
  path = ~/.config/git/gitconfig.local
